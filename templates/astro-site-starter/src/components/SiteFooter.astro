---
import { Mail, MapPin, Phone } from '@lucide/astro';
import type { CompanyProfile } from '@/data/loaders/site-loader';
import { loadNavItems } from '@/data/loaders/site-loader';

interface Props {
  locale: string;
  company: CompanyProfile;
}

const { locale, company } = Astro.props;
const navItems = loadNavItems(locale);
const year = new Date().getFullYear();
---
<footer class="bg-neutral text-neutral-content mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <div class="space-y-3">
        <div class="text-lg font-semibold tracking-tight">{company.name}</div>
        <p class="text-sm text-neutral-content/75 leading-relaxed">{company.summary}</p>
      </div>

      <div class="space-y-3">
        <div class="text-sm font-semibold uppercase tracking-wider text-neutral-content/90">Navigation</div>
        <ul class="space-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a class="link link-hover text-neutral-content/80" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3">
        <div class="text-sm font-semibold uppercase tracking-wider text-neutral-content/90">Direct Contact</div>
        <div class="space-y-2 text-sm text-neutral-content/80">
          {company.email ? (
            <p class="flex items-center gap-2"><Mail class="size-4 shrink-0" /><span>{company.email}</span></p>
          ) : null}
          {company.phone ? (
            <p class="flex items-center gap-2"><Phone class="size-4 shrink-0" /><span>{company.phone}</span></p>
          ) : null}
          {company.address ? (
            <p class="flex items-start gap-2"><MapPin class="size-4 shrink-0 mt-0.5" /><span>{company.address}</span></p>
          ) : null}
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-neutral-content/15 text-xs text-neutral-content/60">
      &copy; {year} {company.name}. All rights reserved.
    </div>
  </div>
</footer>
