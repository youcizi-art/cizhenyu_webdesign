---
import { Send } from '@lucide/astro';

interface Props {
  locale: string;
  defaultProduct?: string;
}

const { locale, defaultProduct = '' } = Astro.props;
const isZh = locale.toLowerCase().startsWith('zh');
---
<form
  id="site-inquiry-form"
  class="card bg-base-100 border border-base-200 shadow-sm"
  data-locale={locale}
>
  <div class="card-body gap-5">
    <h2 class="card-title text-xl">{isZh ? '发送项目询盘' : 'Request Engineering Quote'}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <label class="form-control w-full">
        <span class="label-text text-sm font-medium mb-1.5">{isZh ? '您的姓名 *' : 'Full Name *'}</span>
        <input id="inq-name" name="contact_name" class="input input-bordered w-full" required maxlength="80" />
      </label>
      <label class="form-control w-full">
        <span class="label-text text-sm font-medium mb-1.5">{isZh ? '商务邮箱 *' : 'Business Email *'}</span>
        <input id="inq-email" name="email" type="email" class="input input-bordered w-full" required maxlength="120" />
      </label>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <label class="form-control w-full">
        <span class="label-text text-sm font-medium mb-1.5">{isZh ? '公司名称' : 'Company Name'}</span>
        <input id="inq-company" name="company" class="input input-bordered w-full" maxlength="120" />
      </label>
      <label class="form-control w-full">
        <span class="label-text text-sm font-medium mb-1.5">{isZh ? '意向产品/方案' : 'Product of Interest'}</span>
        <input id="inq-product" name="product_interest" class="input input-bordered w-full" value={defaultProduct} maxlength="120" />
      </label>
    </div>

    <label class="form-control w-full">
      <span class="label-text text-sm font-medium mb-1.5">
        {isZh ? '具体技术参数或采购需求 *' : 'Project Specifications & Volume *'}
      </span>
      <textarea id="inq-message" name="message" class="textarea textarea-bordered w-full" rows="4" required maxlength="2000"></textarea>
    </label>

    <div class="flex items-center gap-4">
      <button type="submit" class="btn btn-primary gap-2">
        <Send class="size-4" />
        <span>{isZh ? '提交询盘' : 'Submit Inquiry'}</span>
      </button>
      <p id="inq-feedback" class="text-sm text-primary" aria-live="polite"></p>
    </div>
  </div>
</form>

<script is:inline>
  (function () {
    const form = document.getElementById('site-inquiry-form');
    const feedback = document.getElementById('inq-feedback');
    if (!form || !feedback) return;
    form.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      const fd = new FormData(form);
      const payload = {
        locale: form.getAttribute('data-locale') || 'en-US',
        contact_name: String(fd.get('contact_name') || ''),
        email: String(fd.get('email') || ''),
        company: String(fd.get('company') || ''),
        product_interest: String(fd.get('product_interest') || ''),
        message: String(fd.get('message') || ''),
      };
      feedback.textContent = '...';
      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        feedback.textContent = data.msg || (res.ok ? 'Submitted' : 'Failed');
        if (res.ok) form.reset();
      } catch (err) {
        feedback.textContent = String(err);
      }
    });
  })();
</script>
