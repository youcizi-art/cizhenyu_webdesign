---
import SeoHead from '@/core/seo/SeoHead.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { getSiteConfig } from '@/core/cms/runtime-env';
import type { CompanyProfile } from '@/data/loaders/site-loader';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: string;
  restPath?: string;
  company: CompanyProfile;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  jsonLdNodes?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  locale,
  restPath = '/',
  company,
  ogImage,
  ogType,
  robots,
  jsonLdNodes = [],
} = Astro.props;

const siteCfg = getSiteConfig() as Record<string, unknown>;
const daisyTheme = String(siteCfg.theme || 'corporate');
const customHeadScript = String(siteCfg.customHeadScript || '').trim();
const canonicalPath = restPath === '/' ? `/${locale}` : `/${locale}${restPath}`;
---
<!DOCTYPE html>
<html lang={locale} data-theme={daisyTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      restPath={restPath}
      locale={locale}
      siteName={company.name}
      ogImage={ogImage}
      ogType={ogType}
      robots={robots}
      jsonLdNodes={jsonLdNodes}
    />
    {customHeadScript ? <Fragment set:html={customHeadScript} /> : null}
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content antialiased">
    <SiteHeader locale={locale} restPath={restPath} companyName={company.name} />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} company={company} />
  </body>
</html>
