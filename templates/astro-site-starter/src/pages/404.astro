---
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDefaultLocale, buildLocalizedPath } from '@/core/i18n/locale';
import { loadCompanyProfile } from '@/data/loaders/site-loader';

const locale = getDefaultLocale();
const company = await loadCompanyProfile(locale);
Astro.response.status = 404;
---
<BaseLayout
  title={`404 | ${company.name}`}
  description="The requested page could not be found."
  locale={locale}
  restPath="/404"
  robots="noindex, nofollow"
  company={company}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-24 text-center space-y-5">
    <div class="badge badge-outline badge-primary">404 Not Found</div>
    <h1 class="text-4xl font-bold tracking-tight">Page Not Found</h1>
    <p class="text-base-content/75">The resource you requested may have moved or been updated.</p>
    <div>
      <a class="btn btn-primary gap-2" href={buildLocalizedPath(locale, '/')}>
        <ArrowLeft class="size-4" />
        <span>Return to Homepage</span>
      </a>
    </div>
  </section>
</BaseLayout>
