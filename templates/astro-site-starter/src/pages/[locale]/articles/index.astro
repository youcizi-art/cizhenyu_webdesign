---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildLocalizedPath, normalizeLocaleCode } from '@/core/i18n/locale';
import { loadArticles, loadCompanyProfile } from '@/data/loaders/site-loader';

const locale = normalizeLocaleCode(Astro.params.locale);
const isZh = locale.toLowerCase().startsWith('zh');
const [company, articles] = await Promise.all([
  loadCompanyProfile(locale),
  loadArticles(locale),
]);
---
<BaseLayout
  title={`${isZh ? '技术资讯' : 'Insights'} | ${company.name}`}
  description={company.summary}
  locale={locale}
  restPath="/articles"
  company={company}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-8">
      {isZh ? '技术资讯与选型指南' : 'Application Notes & Insights'}
    </h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articles.map((a) => (
        <article class="card bg-base-100 border border-base-200 shadow-xs">
          <div class="card-body">
            <div class="text-xs font-medium text-base-content/60">{a.author || company.name}</div>
            <h2 class="card-title text-xl mt-1">{a.title}</h2>
            <p class="text-sm text-base-content/75 leading-relaxed">{a.summary}</p>
            <div class="card-actions justify-start mt-4">
              <a class="btn btn-sm btn-outline gap-1.5" href={buildLocalizedPath(locale, `/articles/${a.slug}`)}>
                <span>{isZh ? '阅读全文' : 'Read Article'}</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
