---
import { Mail, MapPin, Phone } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { normalizeLocaleCode } from '@/core/i18n/locale';
import { loadCompanyProfile } from '@/data/loaders/site-loader';

const locale = normalizeLocaleCode(Astro.params.locale);
const isZh = locale.toLowerCase().startsWith('zh');
const company = await loadCompanyProfile(locale);
---
<BaseLayout
  title={`${isZh ? '联系我们' : 'Contact Us'} | ${company.name}`}
  description={company.summary}
  locale={locale}
  restPath="/contact"
  company={company}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-14 space-y-8">
    <div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
        {isZh ? '联系工程与商务团队' : 'Contact Our Engineering & Sales Team'}
      </h1>
      <div class="mt-4 flex flex-wrap gap-6 text-sm text-base-content/75">
        {company.email ? <span class="inline-flex items-center gap-1.5"><Mail class="size-4 text-primary" />{company.email}</span> : null}
        {company.phone ? <span class="inline-flex items-center gap-1.5"><Phone class="size-4 text-primary" />{company.phone}</span> : null}
        {company.address ? <span class="inline-flex items-center gap-1.5"><MapPin class="size-4 text-primary" />{company.address}</span> : null}
      </div>
    </div>

    <InquiryForm locale={locale} />
  </section>
</BaseLayout>
