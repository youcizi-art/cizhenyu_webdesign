---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeoAnswer from '@/core/geo/GeoAnswer.astro';
import { normalizeLocaleCode } from '@/core/i18n/locale';
import { loadCompanyProfile } from '@/data/loaders/site-loader';

const locale = normalizeLocaleCode(Astro.params.locale);
const isZh = locale.toLowerCase().startsWith('zh');
const company = await loadCompanyProfile(locale);
---
<BaseLayout
  title={`${isZh ? '关于我们' : 'About Us'} | ${company.name}`}
  description={company.summary}
  locale={locale}
  restPath="/about"
  company={company}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-14 space-y-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{company.name}</h1>
    <p class="text-lg text-base-content/75 leading-relaxed">{company.summary}</p>
    <GeoAnswer label={isZh ? '企业定位' : 'Company Overview'} answer={company.short_answer} />
  </section>
</BaseLayout>
