---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeoAnswer from '@/core/geo/GeoAnswer.astro';
import { getSiteOrigin } from '@/core/cms/runtime-env';
import { buildLocalizedPath, normalizeLocaleCode } from '@/core/i18n/locale';
import { buildBreadcrumbJsonLd, buildOrganizationJsonLd } from '@/core/seo/schema-org';
import { loadCompanyProfile } from '@/data/loaders/site-loader';

const locale = normalizeLocaleCode(Astro.params.locale);
const isZh = locale.toLowerCase().startsWith('zh');
const origin = getSiteOrigin(Astro.url.origin);
const company = await loadCompanyProfile(locale);

const jsonLdNodes = [
  buildOrganizationJsonLd(company, origin),
  buildBreadcrumbJsonLd(
    [
      { name: isZh ? '首页' : 'Home', href: buildLocalizedPath(locale, '/') },
      { name: isZh ? '关于我们' : 'About', href: buildLocalizedPath(locale, '/about') },
    ],
    origin
  ),
];
---
<BaseLayout
  title={`${isZh ? '关于我们' : 'About Us'} | ${company.name}`}
  description={company.summary}
  locale={locale}
  restPath="/about"
  company={company}
  jsonLdNodes={jsonLdNodes}
>
  <section class="section-block">
    <div class="container">
      <span class="eyebrow">{company.name}</span>
      <h1 class="hero-title" style="font-size: 2.5rem;">
        {isZh ? '工程驱动的制造与交付体系' : 'Engineering-Driven Manufacturing & Delivery'}
      </h1>
      <p class="hero-desc">{company.summary}</p>
      <GeoAnswer
        label={isZh ? '企业档案摘要' : 'Company Fact Sheet'}
        answer={company.short_answer}
      />
      {company.highlights?.length ? (
        <div class="metrics-bar">
          {company.highlights.map((h) => (
            <div class="metric-card">
              <div class="metric-value">{h.metric}</div>
              <div class="metric-label">{h.label}</div>
            </div>
          ))}
        </div>
      ) : null}
    </div>
  </section>
</BaseLayout>
