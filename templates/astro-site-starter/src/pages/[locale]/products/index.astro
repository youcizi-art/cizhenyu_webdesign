---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildLocalizedPath, normalizeLocaleCode } from '@/core/i18n/locale';
import { loadCompanyProfile, loadProducts } from '@/data/loaders/site-loader';

const locale = normalizeLocaleCode(Astro.params.locale);
const isZh = locale.toLowerCase().startsWith('zh');
const [company, products] = await Promise.all([
  loadCompanyProfile(locale),
  loadProducts(locale),
]);
---
<BaseLayout
  title={`${isZh ? '产品中心' : 'Products'} | ${company.name}`}
  description={company.summary}
  locale={locale}
  restPath="/products"
  company={company}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">
      {isZh ? '产品中心' : 'Products & Solutions'}
    </h1>
    <p class="text-base-content/75 max-w-2xl mb-10">{company.summary}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {products.map((p) => (
        <article class="card bg-base-100 border border-base-200 shadow-xs hover:shadow-md transition-shadow">
          <div class="card-body">
            {p.category_label ? <div class="badge badge-soft badge-primary badge-sm">{p.category_label}</div> : null}
            <h2 class="card-title text-xl mt-1">{p.title}</h2>
            <p class="text-sm text-base-content/75 leading-relaxed">{p.summary}</p>
            <div class="card-actions justify-start mt-4">
              <a class="btn btn-sm btn-primary gap-1.5" href={buildLocalizedPath(locale, `/products/${p.slug}`)}>
                <span>{isZh ? '查看详情与参数' : 'Inspect Specs'}</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
