---
/**
 * 结构化规格参数表（同步支撑页面可读性与 Schema.org PropertyValue 提取）。
 */
interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  title?: string;
  specs?: SpecRow[];
}

const { title = 'Specifications', specs = [] } = Astro.props;
const validRows = specs.filter((row) => row.label && row.value);
---
{validRows.length > 0 ? (
  <section class="space-y-4" data-geo-specs="true">
    <h2 class="text-xl font-bold tracking-tight">{title}</h2>
    <div class="overflow-x-auto rounded-box border border-base-200 bg-base-100">
      <table class="table table-zebra">
        <tbody>
          {validRows.map((row) => (
            <tr>
              <th class="w-1/3 font-medium text-base-content/75 bg-base-200/40">{row.label}</th>
              <td class="text-base-content">{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
) : null}
